{
  "name": "boringstack",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm -r --parallel --filter @boringstack/api-app --filter @boringstack/web dev",
    "dev:api": "pnpm --filter @boringstack/api-app start:dev",
    "dev:web": "pnpm --filter @boringstack/web dev",
    "db:generate": "pnpm --filter @boringstack/db db:generate",
    "db:migrate": "pnpm --filter @boringstack/db db:migrate",
    "db:push": "pnpm --filter @boringstack/db db:push",
    "lint": "eslint \"{apps,packages}/**/*.ts\" --fix",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @boringstack/api-app test:e2e",
    "openapi:export": "pnpm --filter @boringstack/api-app openapi:export"
  },
  "devDependencies": {
    "@boringstack/api": "workspace:*",
    "@nestia/sdk": "^11.2.1",
    "@nestjs/core": "^11.0.1",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "nestia": "^11.2.1",
    "prettier": "^3.4.2",
    "typia": "12.1.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
