{
  "name": "boringstack",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "vp run -r build",
    "dev": "vp run --parallel --filter @boringstack/api-app --filter @boringstack/web dev",
    "dev:api": "vp run --filter @boringstack/api-app start:dev",
    "dev:web": "vp run --filter @boringstack/web dev",
    "db:generate": "vp run --filter @boringstack/db db:generate",
    "db:migrate": "vp run --filter @boringstack/db db:migrate",
    "db:push": "vp run --filter @boringstack/db db:push",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "test": "vp run -r test",
    "test:e2e": "vp run --filter @boringstack/api-app test:e2e",
    "openapi:export": "vp run --filter @boringstack/api-app openapi:export",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@boringstack/api": "workspace:*",
    "@nestia/sdk": "^11.2.1",
    "@nestjs/core": "^11.0.1",
    "globals": "^17.0.0",
    "nestia": "^11.2.1",
    "typescript": "^5.7.3",
    "typia": "12.1.0",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.10.0"
}
